# Copy to .env.local for local development. Never commit real secrets.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Use the same public origin for hosted authentication; replace with the beta URL.
BETTER_AUTH_URL=http://localhost:3000
# Generate a unique secret for each hosted environment. Never commit it.
BETTER_AUTH_SECRET=

# Use a persistent Postgres database in production. Local development can use PGlite.
DATABASE_URL=

# Set rules for an independent beta. This disables external model calls even if a key exists.
PROOFLINE_AI_MODE=rules
# Optional provider integration for a future model-backed mode.
ANTHROPIC_API_KEY=
LLM_MODEL=
# Faster model for in-app agent chat only (drafting still uses LLM_MODEL / Opus).
LLM_CHAT_MODEL=

# Optional job feeds. Company boards, Workday, The Muse, Himalayas, and Jobicy need no key.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
USAJOBS_API_KEY=
USAJOBS_EMAIL=

# Needed for production watched-search cron refreshes.
CRON_SECRET=

# Optional: per-account daily provider-call budget; chat reserves 4 credits per turn (default 40).
PROOFLINE_DAILY_MODEL_CREDITS=40
# Shared provider-call ceiling across all accounts; chat reserves 4 credits per turn (default 80).
PROOFLINE_DAILY_PLATFORM_MODEL_CREDITS=80
