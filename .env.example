# Copy to .env.local and fill in. Never commit real values.
# Nothing below is needed yet: slice 1 (landing page) runs with no env vars.

# Public site URL, used for metadata and absolute links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (slice 2: auth, knowledge base). Free tier is fine.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# LLM layer (slice 3+). Provider is swappable through lib/llm/provider.ts.
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# Scheduled refresh of watched job searches (/api/cron/refresh-searches).
# Vercel Cron sends it as a bearer token. Any long random string works.
CRON_SECRET=
