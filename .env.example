# Copy to .env.local for local development. Never commit real secrets.
# Optional error reporting. Without a DSN, Sentry stays off.
SENTRY_DSN=
# Same full public Client Key DSN URL as SENTRY_DSN. Required at browser build time.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Use the same public origin for hosted authentication; replace with the beta URL.
BETTER_AUTH_URL=http://localhost:3000
# Generate a unique secret for each hosted environment. Never commit it.
BETTER_AUTH_SECRET=

# Use a persistent Postgres database in production. Local development can use PGlite.
DATABASE_URL=
# Existing MongoDB Atlas deployment. Predictions and outcomes have no SQL fallback.
MONGODB_URI=
MONGODB_DB=proofline

# Private beta allowlist: only these addresses can create an account (comma-separated).
# Unset means nobody can sign up. Existing accounts can always sign in.
BETA_EMAILS=

# The one model key (Gemini API key from Google AI Studio). Used only for the resume review gate.
# Unset: AI review shows "temporarily unavailable"; scoring, the linter, and the tracker keep working,
# but new resumes can't pass the gate, so they can't be exported until the key is set.
PROOFLINE_REVIEW_KEY=
# Optional: override the review model (default gemini-3.5-flash-lite).
PROOFLINE_REVIEW_MODEL=

# Optional: send password-reset links by email through Resend. Without these, reset links are
# stored in the inbox_message table (kind = 'password_reset') for the owner to send by hand.
RESEND_API_KEY=
EMAIL_FROM=

# Legacy drafting features stay off unless PROOFLINE_AI_MODE=anthropic (not used in the private beta).
PROOFLINE_AI_MODE=rules
ANTHROPIC_API_KEY=
LLM_MODEL=
# Faster model for in-app agent chat only (drafting still uses LLM_MODEL / Opus).
LLM_CHAT_MODEL=

# Optional job feeds. Company boards, Workday, The Muse, Himalayas, and Jobicy need no key.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
USAJOBS_API_KEY=
USAJOBS_EMAIL=

# Needed for production watched-search cron refreshes.
CRON_SECRET=

# Per-account daily model-call cap, enforced server-side (default 50).
PROOFLINE_DAILY_MODEL_CREDITS=50
# Shared ceiling across all accounts (default 250: five testers at the full cap).
PROOFLINE_DAILY_PLATFORM_MODEL_CREDITS=250
